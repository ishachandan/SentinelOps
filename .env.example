# Feature flag to enable real API integrations (set to true to use real APIs, false for stubs)
USE_REAL_APIS=true

# Groq API key for LLM inference
# Get your free API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Telegram bot credentials for notifications
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# AbuseIPDB API key for real IP reputation checking
# Get your free API key from: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Flask secret key for session management
# Generate with: python -c "import os; print(os.urandom(24).hex())"
FLASK_SECRET_KEY=your_flask_secret_key_here

# Debug endpoints (ONLY enable in development/testing - NEVER in production)
ENABLE_DEBUG_ENDPOINTS=false
